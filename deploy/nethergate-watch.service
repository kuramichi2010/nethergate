[Unit]
Description=nethergate watch (log analysis, rule blocks, AI triage)
After=nethergate-enforcer.service
Wants=nethergate-enforcer.service

[Service]
User=ng-agent
Group=nethergate
SupplementaryGroups=adm
ExecStart=/usr/local/bin/nethergate -config /etc/nethergate/config.json watch
# Optional secrets, e.g. ABUSEIPDB_KEY=... (chmod 600, root-owned)
EnvironmentFile=-/etc/nethergate/env
StateDirectory=nethergate
StateDirectoryMode=0750
UMask=0027
Restart=on-failure

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The triage command runs inside this sandbox. A Node.js based CLI (claude,
# codex) needs a JIT and a writable home: if you enable triage.command, drop
# MemoryDenyWriteExecute and add e.g. ReadWritePaths=/home/ng-agent/.claude
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
